# --- GHL inbound webhooks (one dedicated workflow per funnel step) ---
# Automations → Workflow → Inbound Webhook → copy URL into the matching variable.

# Offer Kickstart Workbook opt-in (/workbook only)
# Default built-in: see DEFAULT_GHL_WORKBOOK_WEBHOOK_URL in src/constants/ghl.ts
# VITE_GHL_WORKBOOK_WEBHOOK_URL=
# VITE_GHL_OFFER_WEBHOOK_URL=   # legacy alias for workbook

# Pre-call qualifier (/calendar warm-up before booking widget)
# Event: pre_call_qualifier · Tags: pre-call-qualifier
# VITE_GHL_PRECALL_WEBHOOK_URL=

# AOF Self-Audit quiz (/aof)
# Event: aof_self_audit_complete · Tags: aof-self-audit + band tag
# Payload meta: score, band, gaps, priorityFixes, whereToStart, pdfUrl, resultsSummary, emailSubject
# VITE_GHL_SELF_AUDIT_WEBHOOK_URL=

# Optional: override FastPayDirect checkout URL for Knowledge to Cash Blueprint ($29.97) on /blueprint
# Default: https://link.fastpaydirect.com/payment-link/6a0fa08bc58f48c13d66730f
# VITE_K2C_CHECKOUT_URL=

# GHL paid booking widget for AOF Master Audit ($1,497) on /aof#purchase
# (separate from the free 15-min qualifying call on /calendar)
# Default: https://api.leadconnectorhq.com/widget/booking/TgyppDdBCvkCzQMwZ2F2
# VITE_AOF_PURCHASE_WIDGET_SRC=

# Optional analytics (GA4 measurement ID or Plausible domain)
# VITE_GA_MEASUREMENT_ID=
# VITE_PLAUSIBLE_DOMAIN=
