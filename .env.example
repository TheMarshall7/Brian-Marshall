# Optional: override the built-in GHL inbound webhook (Offer Kickstart Workbook opt-in on /workbook only)
# (defaults are in src/constants/ghl.ts). In GHL: Automations → workflow → Inbound Webhook → copy URL.
# VITE_GHL_OFFER_WEBHOOK_URL=

# Optional: override FastPayDirect checkout URL for Knowledge to Cash Blueprint ($29.97) on /blueprint
# Default: https://link.fastpaydirect.com/payment-link/6a0fa08bc58f48c13d66730f
# VITE_K2C_CHECKOUT_URL=

# GHL paid booking widget for AOF Master Audit ($1,500) on /aof#purchase
# (separate from the free 15-min qualifying call on /calendar)
# Default: https://api.leadconnectorhq.com/widget/booking/TgyppDdBCvkCzQMwZ2F2
# VITE_AOF_PURCHASE_WIDGET_SRC=

# GHL webhook for AOF Self-Audit lead magnet (falls back to offer webhook).
# Payload includes: score, band, bandSummary, gaps, strengths, priorityFixes,
# whereToStart, resultsSummary, pdfUrl, emailSubject. Wire your GHL email to those fields
# and attach/link public/AOF-Where-To-Start.pdf.
# VITE_GHL_SELF_AUDIT_WEBHOOK_URL=

# Optional analytics (GA4 measurement ID or Plausible domain)
# VITE_GA_MEASUREMENT_ID=
# VITE_PLAUSIBLE_DOMAIN=
